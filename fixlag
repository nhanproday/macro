local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local OriginalData = {
    Parts = {},
    Effects = {},
    Lighting = {},
}

local function ApplyLagFix(v)
    if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam")
        or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles") then
        if not OriginalData.Effects[v] then OriginalData.Effects[v] = {Enabled = v.Enabled} end
        v.Enabled = false
        return
    end

    if v:IsA("Explosion") then
        v.Visible = false
        return
    end

    if v:IsA("Decal") or v:IsA("Texture") then
        if not OriginalData.Effects[v] then OriginalData.Effects[v] = {Transparency = v.Transparency} end
        v.Transparency = 1
        return
    end

    if v:IsA("PostEffect") then
        if not OriginalData.Effects[v] then OriginalData.Effects[v] = {Enabled = v.Enabled} end
        v.Enabled = false
        return
    end

    if v:IsA("Atmosphere") or v:IsA("SunRaysEffect") or v:IsA("Clouds") or v:IsA("Sky") then
        if not OriginalData.Effects[v] then OriginalData.Effects[v] = {Enabled = v.Enabled, Parent = v.Parent} end
        pcall(function() v.Enabled = false end)
        return
    end

    if v:IsA("BasePart") then
        local character = LocalPlayer.Character
        if character and v:IsDescendantOf(character) then return end

        if not OriginalData.Parts[v] then
            OriginalData.Parts[v] = {
                Material = v.Material,
                CastShadow = v.CastShadow,
                Transparency = v.Transparency,
                Reflectance = v.Reflectance,
                CanCollide = v.CanCollide
            }
        end

        v.Material = Enum.Material.SmoothPlastic
        v.CastShadow = false
        v.Reflectance = 0

        local nameLower = v.Name:lower()
        if nameLower:find("effect") or nameLower:find("mesh") or nameLower:find("hit")
            or nameLower:find("vfx") or nameLower:find("skill") or v.Transparency > 0.5 then
            v.Transparency = 1
            v.CanCollide = false
        end
    end

    if v:IsA("SpecialMesh") then
        if not OriginalData.Effects[v] then OriginalData.Effects[v] = {Scale = v.Scale} end
        v.Scale = Vector3.new(0.01, 0.01, 0.01)
    end
end

local function ForceSkyVisible()
    local sky = Lighting:FindFirstChildOfClass("Sky")
    if not sky then
        sky = Instance.new("Sky")
        sky.Name = "ForcedSky"
        sky.Parent = Lighting
    end
    pcall(function()
        sky.SkyboxBk = "rbxasset://textures/sky/sky512_bk.tex"
        sky.SkyboxDn = "rbxasset://textures/sky/sky512_dn.tex"
        sky.SkyboxFt = "rbxasset://textures/sky/sky512_ft.tex"
        sky.SkyboxLf = "rbxasset://textures/sky/sky512_lf.tex"
        sky.SkyboxRt = "rbxasset://textures/sky/sky512_rt.tex"
        sky.SkyboxUp = "rbxasset://textures/sky/sky512_up.tex"
        sky.CelestialBodiesShown = true
        sky.StarCount = 3000
        sky.MoonAngularSize = 12
        sky.SunAngularSize = 21
    end)
end

local function ScanAll()
    for _, v in pairs(Workspace:GetDescendants()) do
        pcall(ApplyLagFix, v)
    end
    for _, v in pairs(Lighting:GetDescendants()) do
        pcall(ApplyLagFix, v)
    end
    ForceSkyVisible()
end

OriginalData.Lighting.GlobalShadows = Lighting.GlobalShadows
OriginalData.Lighting.FogEnd = Lighting.FogEnd
OriginalData.Lighting.FogStart = Lighting.FogStart
OriginalData.Lighting.EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale
OriginalData.Lighting.EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale
OriginalData.Lighting.Ambient = Lighting.Ambient
OriginalData.Lighting.OutdoorAmbient = Lighting.OutdoorAmbient
OriginalData.Lighting.Brightness = Lighting.Brightness
OriginalData.Lighting.ClockTime = Lighting.ClockTime

Lighting.GlobalShadows = false
Lighting.FogEnd = 100000
Lighting.FogStart = 100000
Lighting.EnvironmentDiffuseScale = 0
Lighting.EnvironmentSpecularScale = 0
Lighting.Ambient = Color3.fromRGB(140, 140, 150)
Lighting.OutdoorAmbient = Color3.fromRGB(160, 160, 170)
Lighting.Brightness = 2
Lighting.ClockTime = 14
Lighting.GeographicLatitude = 0

ForceSkyVisible()
ScanAll()

Workspace.DescendantAdded:Connect(function(v)
    task.spawn(function()
        task.wait(0.05)
        if v and v.Parent then pcall(ApplyLagFix, v) end
    end)
end)

Lighting.DescendantAdded:Connect(function(v)
    task.spawn(function()
        task.wait(0.05)
        if v:IsA("Atmosphere") or v:IsA("Sky") then
            pcall(function() v.Enabled = false end)
            if v:IsA("Sky") then ForceSkyVisible() end
        end
    end)
end)

local forceConnection = nil
local lastFaceDir = nil

local function forceFaceStep()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return end

    local moveDir = hum.MoveDirection
    if moveDir.Magnitude < 0.05 then return end

    local fx, fz = moveDir.X, moveDir.Z
    local snappedDir
    if math.abs(fx) > math.abs(fz) then
        if fx > 0 then snappedDir = Vector3.new(1, 0, 0)
        else snappedDir = Vector3.new(-1, 0, 0) end
    else
        if fz > 0 then snappedDir = Vector3.new(0, 0, 1)
        else snappedDir = Vector3.new(0, 0, -1) end
    end

    lastFaceDir = snappedDir
    hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + snappedDir)
end

local function startForceFace()
    if forceConnection then return end
    forceConnection = RunService.RenderStepped:Connect(forceFaceStep)
end

startForceFace()

LocalPlayer.CharacterAdded:Connect(function()
    lastFaceDir = nil
    if forceConnection then
        forceConnection:Disconnect()
        forceConnection = nil
    end
    task.wait(1)
    startForceFace()
    task.wait(0.5)
    ScanAll()
end)
